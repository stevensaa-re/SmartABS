# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

PORT=3000

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartabs
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=smartabs

# --- JWT ---
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- CORS ---
# Alamat tempat frontend dibuka (pisahkan dengan koma).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Zona waktu sekolah (dipakai untuk "hari ini" & jam absen mandiri)
APP_TIMEZONE=Asia/Jakarta
