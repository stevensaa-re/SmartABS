rules_version = '2';

// =========================================================
// SMARTABS — Firestore Security Rules
// Inilah yang menegakkan hak akses di mode Firebase. Kode di browser
// bisa diubah siapa saja, jadi aturan di sini adalah pengaman sebenarnya.
//
// Deploy:  firebase deploy --only firestore:rules
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() { return request.auth != null; }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'Aktif'
        && (me().get('schoolId', '') == ''
          || (exists(/databases/$(database)/documents/schools/$(me().schoolId))
            && get(/databases/$(database)/documents/schools/$(me().schoolId)).data.status == 'Aktif'));
    }

    function isAdmin()      { return active() && me().role == 'admin'; }
    function isGuru()       { return active() && me().role == 'guru'; }
    function isSiswa()      { return active() && me().role == 'siswa'; }
    function isStaff()      { return isAdmin() || isGuru(); }
    function auditActor() {
      let actor = me();
      return actor.role in ['admin', 'guru'] && actor.status == 'Aktif';
    }
    function schoolId()     { return me().get('schoolId', ''); }
    function sameSchool(data) {
      return signedIn() && data.get('schoolId', '') == schoolId();
    }
    function newDataInMySchool() {
      return sameSchool(request.resource.data);
    }
    function activeSemesterSchedule(schedule) {
      return schoolId() != ''
        && exists(/databases/$(database)/documents/schools/$(schoolId()))
        && schedule.semesterId is string
        && schedule.semesterId != ''
        && get(/databases/$(database)/documents/schools/$(schoolId())).data.activeSemesterId
          == schedule.semesterId;
    }
    function activeTeacherAssignment(schedule) {
      let assignmentPath = /databases/$(database)/documents/semesterConfigurations/$(schedule.get('teacherAssignmentId', ''));
      let assignment = get(assignmentPath).data;
      return schedule.get('teacherAssignmentId', '') is string
        && schedule.get('teacherAssignmentId', '') != ''
        && exists(assignmentPath)
        && sameSchool(assignment)
        && assignment.type == 'teacherAssignments'
        && assignment.semesterId == schedule.semesterId
        && assignment.payload.teacherUid == schedule.teacherUid
        && assignment.payload.classId == schedule.classId
        && assignment.payload.subjectId == schedule.subjectId;
    }
    function assignedAttendanceSchedule(scheduleId) {
      let schedulePath = /databases/$(database)/documents/schedules/$(scheduleId);
      let schedule = get(schedulePath).data;
      let assignmentPath = /databases/$(database)/documents/semesterConfigurations/$(schedule.get('teacherAssignmentId', ''));
      return isGuru()
        && exists(schedulePath)
        && sameSchool(schedule)
        && schedule.teacherUid == request.auth.uid
        && activeSemesterSchedule(schedule)
        && schedule.get('teacherAssignmentId', '') is string
        && schedule.get('teacherAssignmentId', '') != ''
        && exists(assignmentPath)
        && sameSchool(get(assignmentPath).data)
        && get(assignmentPath).data.type == 'teacherAssignments'
        && get(assignmentPath).data.semesterId == schedule.semesterId
        && get(assignmentPath).data.payload.teacherUid == request.auth.uid;
    }
    function enrolledIn(studentId, className) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && sameSchool(get(/databases/$(database)/documents/students/$(studentId)).data)
        && get(/databases/$(database)/documents/students/$(studentId)).data.className == className;
    }

    // NIS milik siswa yang login (diisi admin saat menghubungkan akun ke siswa)
    function myNis()        { return me().get('nis', ''); }
    function myClassName() {
      return isSiswa() && myNis() != ''
        && exists(/databases/$(database)/documents/students/$(myNis()))
        && sameSchool(get(/databases/$(database)/documents/students/$(myNis())).data)
        ? get(/databases/$(database)/documents/students/$(myNis())).data.className
        : '';
    }
    function hasAttendanceHistory(id) {
      return request.resource.data.lastChangeId is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/attendance/$(id)/history/$(request.resource.data.lastChangeId))
        && getAfter(/databases/$(database)/documents/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.actorUid
          == request.auth.uid;
    }
    function validPermissionAttendance(id) {
      return isAdmin()
        && request.resource.data.source == 'permission'
        && request.resource.data.permissionId is string
        && id == request.resource.data.date + '_' + request.resource.data.studentId
        && matchingReviewedPermission(request.resource.data.permissionId)
        && request.resource.data.createdAt == request.time
        && hasAttendanceHistory(id);
    }
    function matchingReviewedPermission(permissionId) {
      let permission = get(
        /databases/$(database)/documents/permissions/$(permissionId)
      ).data;
      return sameSchool(permission)
        && permission.status in ['Disetujui', 'Ditolak']
        && permission.studentId == request.resource.data.studentId
        && permission.className == request.resource.data.className
        && permission.date == request.resource.data.date
        && ((permission.status == 'Disetujui' && request.resource.data.status == permission.type)
          || (permission.status == 'Ditolak' && request.resource.data.status == 'Alpa'));
    }
    function validManualAttendance(id) {
      return isStaff()
        && (isAdmin() || enrolledIn(request.resource.data.studentId, request.resource.data.className))
        && request.resource.data.status in ['Hadir', 'Terlambat', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time
        && (
          (isAdmin()
            && id == request.resource.data.date + '_' + request.resource.data.studentId
            && !request.resource.data.keys().hasAny(['sessionId']))
          || (request.resource.data.scheduleId is string
            && exists(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId))
            && sameSchool(get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data)
            && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.className
              == request.resource.data.className
            && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.subject
              == request.resource.data.subject
            && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.teacherUid
              == request.resource.data.teacherUid
            && (isAdmin() || assignedAttendanceSchedule(request.resource.data.scheduleId))
            && request.resource.data.source == 'manual'
            && id == request.resource.data.scheduleId + '_' + request.resource.data.date + '_' + request.resource.data.studentId)
        );
    }
    function validTeacherManualAttendance(id) {
      let schedulePath = /databases/$(database)/documents/schedules/$(request.resource.data.scheduleId);
      let assignmentPath = /databases/$(database)/documents/semesterConfigurations/$(get(schedulePath).data.get('teacherAssignmentId', ''));
      let studentPath = /databases/$(database)/documents/students/$(request.resource.data.studentId);
      return isGuru()
        && newDataInMySchool()
        && request.resource.data.source == 'manual'
        && request.resource.data.scheduleId is string
        && exists(schedulePath)
        && exists(assignmentPath)
        && exists(studentPath)
        && sameSchool(get(schedulePath).data)
        && sameSchool(get(assignmentPath).data)
        && sameSchool(get(studentPath).data)
        && get(schedulePath).data.teacherUid == request.auth.uid
        && get(schedulePath).data.className == request.resource.data.className
        && get(schedulePath).data.subject == request.resource.data.subject
        && get(studentPath).data.className == request.resource.data.className
        && activeSemesterSchedule(get(schedulePath).data)
        && get(assignmentPath).data.type == 'teacherAssignments'
        && get(assignmentPath).data.semesterId == get(schedulePath).data.semesterId
        && get(assignmentPath).data.payload.teacherUid == request.auth.uid
        && id == request.resource.data.scheduleId + '_' + request.resource.data.date + '_' + request.resource.data.studentId
        && request.resource.data.status in ['Hadir', 'Terlambat', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time;
    }
    function validAdminManualAttendance(id) {
      return isAdmin()
        && newDataInMySchool()
        && request.resource.data.source == 'manual'
        && id == request.resource.data.date + '_' + request.resource.data.studentId
        && !request.resource.data.keys().hasAny(['sessionId'])
        && request.resource.data.status in ['Hadir', 'Terlambat', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time;
    }

    // ---------- users ----------
    // Pengguna boleh membaca profilnya sendiri; admin mengelola semuanya.
    match /users/{uid} {
      allow read: if (isAdmin() && sameSchool(resource.data))
        || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        && newDataInMySchool()
        && request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif'];
      allow delete: if isAdmin() && sameSchool(resource.data);
      // Admin boleh mengubah profil lain; pengguna tidak boleh mengubah role/status sendiri.
      allow update: if isAdmin()
        && sameSchool(resource.data)
        && newDataInMySchool()
        && request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif'];
    }

    // ---------- data master ----------
    match /classes/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (isSiswa() && resource.data.name == myClassName()));
      allow create, update, delete: if false;
    }

    match /schedules/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin()
          || (isGuru() && resource.data.teacherUid == request.auth.uid
            && activeSemesterSchedule(resource.data) && activeTeacherAssignment(resource.data))
          || (isSiswa() && resource.data.className == myClassName()
            && activeSemesterSchedule(resource.data) && activeTeacherAssignment(resource.data)));
      allow create, update, delete: if false;
    }

    match /announcements/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (active() && resource.data.status == 'Publish'));
      allow create: if isAdmin() && newDataInMySchool();
      allow update: if isAdmin() && sameSchool(resource.data) && newDataInMySchool();
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    match /teachers/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (isGuru() && resource.data.username == me().username));
      allow create: if isAdmin() && newDataInMySchool();
      allow update: if isAdmin() && sameSchool(resource.data) && newDataInMySchool();
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    match /students/{nis} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (isSiswa() && nis == myNis()));
      allow create: if isAdmin() && newDataInMySchool();
      allow update: if isAdmin() && sameSchool(resource.data) && newDataInMySchool();
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    // ---------- absensi ----------
    // Catatan lama memakai "{tanggal}_{nis}"; absensi QR memakai "{sesi}_{nis}".
    match /attendance/{id} {
      allow read: if (isSiswa() && myNis() != ''
          && id.matches('.*_' + myNis() + '$')
          && !exists(/databases/$(database)/documents/attendance/$(id)))
        || (sameSchool(resource.data) && (isAdmin()
          || (isGuru() && resource.data.teacherUid == request.auth.uid)
          || (isSiswa() && myNis() != '' && id.matches('.*_' + myNis() + '$'))
          || (isSiswa() && resource.data.studentId == myNis())));

      allow create: if (request.resource.data.source == 'permission'
          && validPermissionAttendance(id))
        || (request.resource.data.source == 'manual'
          && (validTeacherManualAttendance(id) || validAdminManualAttendance(id)));
      allow update: if sameSchool(resource.data) && newDataInMySchool()
        && ((validPermissionAttendance(id)
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.date == request.resource.data.date
          && resource.data.className == request.resource.data.className)
        || (validManualAttendance(id)
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.date == request.resource.data.date
          && (isAdmin() || (isGuru()
            && resource.data.teacherUid == request.auth.uid
            && request.resource.data.teacherUid == request.auth.uid))
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.className == resource.data.className));
      allow delete: if false;

      // Absensi QR: satu dokumen per siswa per sesi, divalidasi terhadap token
      // aktif di server Rules menggunakan request.time, bukan jam perangkat siswa.
      match /history/{changeId} {
        allow read: if exists(/databases/$(database)/documents/attendance/$(id))
          && sameSchool(get(/databases/$(database)/documents/attendance/$(id)).data)
          && (isAdmin()
          || (exists(/databases/$(database)/documents/attendance/$(id))
            && ((isGuru()
                && get(/databases/$(database)/documents/attendance/$(id)).data.teacherUid == request.auth.uid)
              || (isGuru()
                && get(/databases/$(database)/documents/attendance/$(id)).data.teacherUid == request.auth.uid)
              || (isSiswa() && get(/databases/$(database)/documents/attendance/$(id)).data.studentId == myNis()))));
        allow create: if signedIn()
          && auditActor()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- sesi QR absensi ----------
    match /attendanceSessions/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (isGuru() && resource.data.teacherUid == request.auth.uid));
      allow create, update, delete: if false;
    }

    // ---------- izin / sakit ----------
    match /permissions/{id} {
      allow read: if sameSchool(resource.data)
        && (isAdmin() || (isSiswa() && resource.data.studentId == myNis()));
      allow update: if isAdmin() && sameSchool(resource.data) && newDataInMySchool()
        && resource.data.status == 'Menunggu'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Disetujui', 'Ditolak'];
      allow delete: if sameSchool(resource.data) && isAdmin();

      allow create: if newDataInMySchool() && (isAdmin()
        || (isSiswa()
          && request.resource.data.keys().hasAll(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
          && request.resource.data.keys().hasOnly(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
          && request.resource.data.studentId == myNis()
          && exists(/databases/$(database)/documents/students/$(myNis()))
          && request.resource.data.name == get(/databases/$(database)/documents/students/$(myNis())).data.name
          && request.resource.data.className == get(/databases/$(database)/documents/students/$(myNis())).data.className
          && request.resource.data.status == 'Menunggu'
          && request.resource.data.type in ['Izin', 'Sakit']));
    }

    // ---------- kalender akademik ----------
    match /calendarEvents/{id} {
      allow read: if sameSchool(resource.data);
      allow create: if isAdmin() && newDataInMySchool()
        && request.resource.data.keys().hasAll(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.isHoliday is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && sameSchool(resource.data) && newDataInMySchool()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.isHoliday is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && sameSchool(resource.data);
    }

    // Konfigurasi semester hanya dapat diubah melalui Cloud Functions tepercaya.
    match /semesters/{id} {
      allow read: if isAdmin() && sameSchool(resource.data);
      allow create, update, delete: if false;
    }

    match /semesterConfigurations/{id} {
      allow read: if isAdmin() && sameSchool(resource.data);
      allow create, update, delete: if false;
    }

    // Audit bersifat append-only dan hanya dapat dibaca admin.
    match /auditLogs/{id} {
      allow read: if isAdmin() && sameSchool(resource.data);
      allow create: if isStaff() && newDataInMySchool()
        && request.resource.data.keys().hasAll(['actorUid', 'actorName', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'createdAt'])
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == me().role
        && request.resource.data.action is string
        && request.resource.data.entity is string
        && request.resource.data.summary is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Selain yang tertulis di atas: tolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
