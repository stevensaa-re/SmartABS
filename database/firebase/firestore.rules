rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() { return profileExists() && me().status == 'Aktif'; }
    function platformAdmin() {
      return active()
        && me().role == 'admin'
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }
    function schoolExists(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'Aktif';
    }
    function belongsToSchool(schoolId) {
      return active() && me().schoolId == schoolId && schoolExists(schoolId);
    }
    function isAdmin(schoolId) { return belongsToSchool(schoolId) && me().role == 'admin'; }
    function adminOfOwnSchool() {
      return active() && me().role == 'admin' && schoolExists(me().schoolId);
    }
    function isGuru(schoolId) { return belongsToSchool(schoolId) && me().role == 'guru'; }
    function isSiswa(schoolId) { return belongsToSchool(schoolId) && me().role == 'siswa'; }
    function isStaff(schoolId) { return isAdmin(schoolId) || isGuru(schoolId); }
    function assignedClass() { return me().get('className', ''); }
    function teaches(schoolId, className) {
      return isGuru(schoolId) && assignedClass() != '' && assignedClass() == className;
    }
    function myNis() { return me().get('nis', ''); }
    function studentPath(schoolId, nis) {
      return /databases/$(database)/documents/schools/$(schoolId)/students/$(nis);
    }
    function myClassName(schoolId) {
      return isSiswa(schoolId) && myNis() != ''
        && exists(studentPath(schoolId, myNis()))
        ? get(studentPath(schoolId, myNis())).data.className
        : '';
    }
    function enrolledIn(schoolId, studentId, className) {
      return exists(studentPath(schoolId, studentId))
        && get(studentPath(schoolId, studentId)).data.className == className;
    }
    function sessionPath(schoolId, sessionId) {
      return /databases/$(database)/documents/schools/$(schoolId)/attendanceSessions/$(sessionId);
    }
    function schedulePath(schoolId, scheduleId) {
      return /databases/$(database)/documents/schools/$(schoolId)/schedules/$(scheduleId);
    }
    function validQrAttendance(schoolId, id) {
      let session = get(sessionPath(schoolId, request.resource.data.sessionId)).data;
      let student = get(studentPath(schoolId, myNis())).data;
      return isSiswa(schoolId)
        && request.resource.data.keys().hasAll([
          'sessionId', 'sessionToken', 'scheduleId', 'subject', 'studentId',
          'name', 'className', 'date', 'time', 'status', 'note', 'createdAt',
          'sessionStartedAt', 'source'
        ])
        && request.resource.data.keys().hasOnly([
          'sessionId', 'sessionToken', 'scheduleId', 'subject', 'studentId',
          'name', 'className', 'date', 'time', 'status', 'note', 'createdAt',
          'sessionStartedAt', 'source'
        ])
        && exists(sessionPath(schoolId, request.resource.data.sessionId))
        && session.active == true
        && session.expiresAt > request.time
        && (session.token == request.resource.data.sessionToken
          || (session.get('previousToken', '') != ''
            && session.previousToken == request.resource.data.sessionToken))
        && session.scheduleId == request.resource.data.scheduleId
        && session.subject == request.resource.data.subject
        && session.className == request.resource.data.className
        && session.date == request.resource.data.date
        && request.resource.data.studentId == myNis()
        && request.resource.data.className == myClassName(schoolId)
        && request.resource.data.name == student.name
        && request.resource.data.status == 'Hadir'
        && request.resource.data.source == 'qr'
        && request.resource.data.time == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.sessionStartedAt.seconds() == session.createdAt.seconds()
        && id == request.resource.data.sessionId + '_' + myNis();
    }
    function validManualAttendance(schoolId, id) {
      return isStaff(schoolId)
        && (isAdmin(schoolId) || enrolledIn(schoolId, request.resource.data.studentId, request.resource.data.className))
        && (isAdmin(schoolId) || teaches(schoolId, request.resource.data.className))
        && request.resource.data.status in ['Hadir', 'Terlambat', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time
        && (
          (id == request.resource.data.date + '_' + request.resource.data.studentId
            && !request.resource.data.keys().hasAny(['sessionId']))
          || (request.resource.data.sessionId is string
            && id == request.resource.data.sessionId + '_' + request.resource.data.studentId
            && exists(sessionPath(schoolId, request.resource.data.sessionId))
            && get(sessionPath(schoolId, request.resource.data.sessionId)).data.date == request.resource.data.date
            && get(sessionPath(schoolId, request.resource.data.sessionId)).data.className == request.resource.data.className
            && get(sessionPath(schoolId, request.resource.data.sessionId)).data.scheduleId == request.resource.data.scheduleId
            && get(sessionPath(schoolId, request.resource.data.sessionId)).data.subject == request.resource.data.subject)
        )
        && request.resource.data.lastChangeId is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId))
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.studentId == request.resource.data.studentId
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.className == request.resource.data.className
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.nextStatus == request.resource.data.status
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.nextNote == request.resource.data.note
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)/history/$(request.resource.data.lastChangeId)).data.createdAt == request.time;
    }

    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid
        || (adminOfOwnSchool() && resource.data.schoolId == me().schoolId);
      allow create: if request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif']
        && (
          (isAdmin(request.resource.data.schoolId) && request.resource.data.schoolId == me().schoolId)
          || (platformAdmin() && schoolExists(request.resource.data.schoolId))
        );
      allow update: if isAdmin(resource.data.schoolId)
        && resource.data.schoolId == me().schoolId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif'];
      allow delete: if isAdmin(resource.data.schoolId) && resource.data.schoolId == me().schoolId;
    }

    match /schools/{schoolId} {
      allow read: if platformAdmin() || belongsToSchool(schoolId);
      allow create: if platformAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status == 'Aktif';
      allow update: if platformAdmin()
        || (isAdmin(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'address', 'phone', 'educationLevels', 'majors', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.educationLevels is list
          && request.resource.data.majors is list);
      allow delete: if platformAdmin();

      match /classes/{id} {
        allow read: if isAdmin(schoolId) || teaches(schoolId, resource.data.name)
          || (isSiswa(schoolId) && resource.data.name == myClassName(schoolId));
        allow write: if isAdmin(schoolId);
      }
      match /schedules/{id} {
        allow read: if isAdmin(schoolId) || teaches(schoolId, resource.data.className)
          || (isSiswa(schoolId) && resource.data.className == myClassName(schoolId));
        allow write: if isAdmin(schoolId);
      }
      match /announcements/{id} {
        allow read: if isAdmin(schoolId) || (belongsToSchool(schoolId) && resource.data.status == 'Publish');
        allow write: if isAdmin(schoolId);
      }
      match /teachers/{id} {
        allow read: if isAdmin(schoolId) || (isGuru(schoolId) && resource.data.username == me().username);
        allow write: if isAdmin(schoolId);
      }
      match /students/{nis} {
        allow read: if isAdmin(schoolId) || teaches(schoolId, resource.data.className)
          || (isSiswa(schoolId) && nis == myNis());
        allow write: if isAdmin(schoolId);
      }
      match /attendance/{id} {
        allow read: if isAdmin(schoolId) || teaches(schoolId, resource.data.className)
          || (isSiswa(schoolId) && myNis() != '' && id.matches('.*_' + myNis() + '$'))
          || (isSiswa(schoolId) && resource.data.studentId == myNis());
        allow create: if validManualAttendance(schoolId, id) || validQrAttendance(schoolId, id);
        allow update: if validManualAttendance(schoolId, id)
          && resource.data.studentId == request.resource.data.studentId
          && resource.data.date == request.resource.data.date
          && (isAdmin(schoolId) || teaches(schoolId, resource.data.className))
          && request.resource.data.className == resource.data.className;
        allow delete: if false;
        match /history/{changeId} {
          allow read: if isAdmin(schoolId)
            || (exists(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id))
              && (teaches(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.className)
                || (isSiswa(schoolId) && get(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.studentId == myNis())));
          allow create: if isStaff(schoolId)
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() >= 5
            && request.resource.data.createdAt == request.time
            && existsAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id))
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.lastChangeId == changeId
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.studentId == request.resource.data.studentId
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.className == request.resource.data.className
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.date == request.resource.data.date
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.status == request.resource.data.nextStatus
            && getAfter(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.note == request.resource.data.nextNote
            && (isAdmin(schoolId) || teaches(schoolId, request.resource.data.className))
            && (exists(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id))
              ? request.resource.data.previousStatus == get(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.status
                && request.resource.data.previousNote == get(/databases/$(database)/documents/schools/$(schoolId)/attendance/$(id)).data.get('note', '')
              : request.resource.data.previousStatus == ''
                && request.resource.data.previousNote == '');
          allow update, delete: if false;
        }
      }
      match /attendanceSessions/{id} {
        allow read: if isAdmin(schoolId) || (isGuru(schoolId) && resource.data.teacherUid == request.auth.uid);
        allow create: if (isAdmin(schoolId) || isGuru(schoolId))
          && request.resource.data.keys().hasAll([
            'scheduleId', 'subject', 'className', 'date', 'teacherUid', 'teacherName',
            'token', 'previousToken', 'active', 'expiresAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'scheduleId', 'subject', 'className', 'date', 'teacherUid', 'teacherName',
            'token', 'previousToken', 'active', 'expiresAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.previousToken is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.active == false
          && exists(schedulePath(schoolId, request.resource.data.scheduleId))
          && get(schedulePath(schoolId, request.resource.data.scheduleId)).data.className == request.resource.data.className
          && get(schedulePath(schoolId, request.resource.data.scheduleId)).data.subject == request.resource.data.subject
          && (isAdmin(schoolId) || (teaches(schoolId, request.resource.data.className)
            && get(schedulePath(schoolId, request.resource.data.scheduleId)).data.teacher == me().name));
        allow update: if isAdmin(schoolId)
          || (isGuru(schoolId)
            && resource.data.teacherUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['token', 'previousToken', 'expiresAt', 'updatedAt', 'active', 'closedAt'])
            && request.resource.data.updatedAt == request.time
            && (request.resource.data.active == false
              || (request.resource.data.token is string
                && request.resource.data.token.size() == 32
                && request.resource.data.expiresAt > request.time)));
        allow delete: if isAdmin(schoolId) || isGuru(schoolId);
      }
      match /permissions/{id} {
        allow read: if isAdmin(schoolId) || teaches(schoolId, resource.data.className)
          || (isSiswa(schoolId) && resource.data.studentId == myNis());
        allow update: if (isAdmin(schoolId) || (teaches(schoolId, resource.data.className)
          && teaches(schoolId, request.resource.data.className)))
          && request.resource.data.status in ['Menunggu', 'Disetujui', 'Ditolak'];
        allow delete: if isAdmin(schoolId) || teaches(schoolId, resource.data.className);
        allow create: if isAdmin(schoolId)
          || (isSiswa(schoolId)
            && request.resource.data.keys().hasAll(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
            && request.resource.data.keys().hasOnly(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
            && request.resource.data.studentId == myNis()
            && exists(studentPath(schoolId, myNis()))
            && request.resource.data.name == get(studentPath(schoolId, myNis())).data.name
            && request.resource.data.className == get(studentPath(schoolId, myNis())).data.className
            && request.resource.data.status == 'Menunggu'
            && request.resource.data.type in ['Izin', 'Sakit']);
      }
      match /calendarEvents/{id} {
        allow read: if belongsToSchool(schoolId);
        allow create: if isAdmin(schoolId)
          && request.resource.data.keys().hasAll(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.startDate is string
          && request.resource.data.endDate is string
          && request.resource.data.startDate <= request.resource.data.endDate
          && request.resource.data.isHoliday is bool
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isAdmin(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'type', 'startDate', 'endDate', 'description', 'isHoliday', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.startDate <= request.resource.data.endDate
          && request.resource.data.isHoliday is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin(schoolId);
      }
      match /auditLogs/{id} {
        allow read: if isAdmin(schoolId);
        allow create: if isStaff(schoolId)
          && request.resource.data.keys().hasAll(['actorUid', 'actorName', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'createdAt'])
          && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == me().role
          && request.resource.data.action is string
          && request.resource.data.entity is string
          && request.resource.data.summary is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Legacy flat collections are intentionally denied. Move existing data to its
    // school path and assign schoolId to every user profile before deploying.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
