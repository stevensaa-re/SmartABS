rules_version = '2';

// =========================================================
// SMARTABS — Firestore Security Rules
// Inilah yang menegakkan hak akses di mode Firebase. Kode di browser
// bisa diubah siapa saja, jadi aturan di sini adalah pengaman sebenarnya.
//
// Deploy:  firebase deploy --only firestore:rules
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() { return request.auth != null; }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'Aktif';
    }

    function isAdmin()      { return active() && me().role == 'admin'; }
    function isGuru()       { return active() && me().role == 'guru'; }
    function isSiswa()      { return active() && me().role == 'siswa'; }
    function isStaff()      { return isAdmin() || isGuru(); }
    function assignedClass() { return me().get('className', ''); }
    function teaches(className) {
      return isGuru() && assignedClass() != '' && className == assignedClass();
    }
    function enrolledIn(studentId, className) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.className == className;
    }

    // NIS milik siswa yang login (diisi admin saat menghubungkan akun ke siswa)
    function myNis()        { return me().get('nis', ''); }
    function myClassName() {
      return isSiswa() && myNis() != ''
        && exists(/databases/$(database)/documents/students/$(myNis()))
        ? get(/databases/$(database)/documents/students/$(myNis())).data.className
        : '';
    }
    function qrSession(sessionId) {
      return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data;
    }
    function validQrAttendance(id) {
      return isSiswa()
        && request.resource.data.keys().hasAll([
          'sessionId', 'sessionToken', 'scheduleId', 'subject', 'studentId',
          'name', 'className', 'date', 'time', 'status', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sessionId', 'sessionToken', 'scheduleId', 'subject', 'studentId',
          'name', 'className', 'date', 'time', 'status', 'note', 'createdAt'
        ])
        && exists(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId))
        && qrSession(request.resource.data.sessionId).active == true
        && qrSession(request.resource.data.sessionId).expiresAt > request.time
        && qrSession(request.resource.data.sessionId).token == request.resource.data.sessionToken
        && qrSession(request.resource.data.sessionId).scheduleId == request.resource.data.scheduleId
        && qrSession(request.resource.data.sessionId).subject == request.resource.data.subject
        && qrSession(request.resource.data.sessionId).className == request.resource.data.className
        && qrSession(request.resource.data.sessionId).date == request.resource.data.date
        && request.resource.data.studentId == myNis()
        && request.resource.data.className == myClassName()
        && request.resource.data.name == get(/databases/$(database)/documents/students/$(myNis())).data.name
        && request.resource.data.status == 'Hadir'
        && request.resource.data.time == request.time
        && request.resource.data.createdAt == request.time
        && id == request.resource.data.sessionId + '_' + myNis();
    }

    // ---------- users ----------
    // Pengguna boleh membaca profilnya sendiri; admin mengelola semuanya.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        && request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif'];
      allow delete: if isAdmin();
      // Admin boleh mengubah profil lain; pengguna tidak boleh mengubah role/status sendiri.
      allow update: if isAdmin()
        && request.resource.data.role in ['admin', 'guru', 'siswa']
        && request.resource.data.status in ['Aktif', 'Nonaktif'];
    }

    // ---------- data master ----------
    match /classes/{id} {
      allow read: if isAdmin() || teaches(resource.data.name)
        || (isSiswa() && resource.data.name == myClassName());
      allow write: if isAdmin();
    }

    match /schedules/{id} {
      allow read: if isAdmin() || teaches(resource.data.className)
        || (isSiswa() && resource.data.className == myClassName());
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isAdmin() || (active() && resource.data.status == 'Publish');
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isAdmin() || (isGuru() && resource.data.username == me().username);
      allow write: if isAdmin();
    }

    match /students/{nis} {
      allow read: if isAdmin() || teaches(resource.data.className) || (isSiswa() && nis == myNis());
      allow write: if isAdmin();
    }

    // ---------- absensi ----------
    // Catatan lama memakai "{tanggal}_{nis}"; absensi QR memakai "{sesi}_{nis}".
    match /attendance/{id} {
      allow read: if isAdmin() || teaches(resource.data.className)
        || (isSiswa() && (resource.data.studentId == myNis()
          || id.matches('.*_' + myNis())));

      allow create: if (isAdmin() || teaches(request.resource.data.className))
        && request.resource.data.status in ['Hadir', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time
        && id == request.resource.data.date + '_' + request.resource.data.studentId
        && (isAdmin() || enrolledIn(request.resource.data.studentId, request.resource.data.className));
      allow update: if isAdmin() || (teaches(resource.data.className)
        && teaches(request.resource.data.className)
        && request.resource.data.status in ['Hadir', 'Izin', 'Sakit', 'Alpa']
        && request.resource.data.createdAt == request.time
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.date == resource.data.date
        && id == request.resource.data.date + '_' + request.resource.data.studentId
        && enrolledIn(request.resource.data.studentId, request.resource.data.className));
      allow delete: if isAdmin() || teaches(resource.data.className);

      // Absensi QR: satu dokumen per siswa per sesi, divalidasi terhadap token
      // aktif di server Rules menggunakan request.time, bukan jam perangkat siswa.
      allow create: if validQrAttendance(id);
    }

    // ---------- sesi QR absensi ----------
    match /attendanceSessions/{id} {
      allow read: if isAdmin()
        || (isGuru() && resource.data.className == assignedClass()
          && resource.data.teacherUid == request.auth.uid);
      allow create: if (isAdmin() || (isGuru() && request.resource.data.className == assignedClass()))
        && request.resource.data.keys().hasAll([
          'scheduleId', 'subject', 'className', 'date', 'teacherUid', 'teacherName',
          'token', 'active', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'scheduleId', 'subject', 'className', 'date', 'teacherUid', 'teacherName',
          'token', 'active', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.active == false
        && exists(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId))
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.className == request.resource.data.className
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.subject == request.resource.data.subject
        && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.teacher == request.resource.data.teacherName
        && (isAdmin() || request.resource.data.teacherName == me().name);
      allow update: if isAdmin()
        || (isGuru()
          && resource.data.teacherUid == request.auth.uid
          && resource.data.className == assignedClass()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['token', 'expiresAt', 'updatedAt', 'active', 'closedAt'])
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.active == false
            || (request.resource.data.token is string
              && request.resource.data.token.size() == 32
              && request.resource.data.expiresAt > request.time
              && request.resource.data.expiresAt <= request.time + duration.value(35, 's'))));
      allow delete: if isAdmin();
    }

    // ---------- izin / sakit ----------
    match /permissions/{id} {
      allow read: if isAdmin() || teaches(resource.data.className)
        || (isSiswa() && resource.data.studentId == myNis());
      allow update: if (isAdmin() || (teaches(resource.data.className)
        && teaches(request.resource.data.className)))
        && request.resource.data.status in ['Menunggu', 'Disetujui', 'Ditolak'];
      allow delete: if isAdmin() || teaches(resource.data.className);

      allow create: if isSiswa()
        && request.resource.data.keys().hasAll(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
        && request.resource.data.keys().hasOnly(['studentId', 'name', 'className', 'date', 'type', 'note', 'status'])
        && request.resource.data.studentId == myNis()
        && exists(/databases/$(database)/documents/students/$(myNis()))
        && request.resource.data.name == get(/databases/$(database)/documents/students/$(myNis())).data.name
        && request.resource.data.className == get(/databases/$(database)/documents/students/$(myNis())).data.className
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.type in ['Izin', 'Sakit'];
    }

    // Selain yang tertulis di atas: tolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
